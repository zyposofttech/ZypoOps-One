{
  "name": "zyposoft-operations-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "lint": "eslint packages services tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/contract/*.test.ts",
    "test:interop": "node --test tests/cryptography/*.test.ts",
    "test:tenancy": "node --test tests/tenancy/*.test.ts",
    "db:generate": "prisma generate --schema packages/database/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@prisma/client": "6.19.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.0",
    "@eslint/js": "9.39.1"
  }
}
