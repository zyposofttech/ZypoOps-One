{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:zyposoft:ops:local:product-management:v1.2.0",
  "type":"object",
  "additionalProperties":false,
  "title":"LOCAL-01 authenticated Unix-socket product-management payloads (proposed)",
  "description":"Schema definitions for endpoint-specific bodies; systemd/Unix SO_PEERCRED authentication and transport are enforced separately. Never transmit patient data.",
  "$defs":{
    "locks_response":{"type":"object","additionalProperties":false,"properties":{
      "locked":{"type":"boolean"},"reasons":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9_]{3,40}$"}},
      "lease_ttl_s":{"type":"integer","minimum":0,"maximum":300},"revision":{"type":"string","minLength":1,"maxLength":80}},"required":["locked","reasons","lease_ttl_s","revision"]},
    "readiness_response":{"type":"object","additionalProperties":false,"properties":{
      "ready":{"type":"boolean"},"service_codes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9_]{3,40}$"}},
      "version":{"type":"string","minLength":1,"maxLength":80}},"required":["ready","service_codes","version"]},
    "profile_stage_request":{"type":"object","additionalProperties":false,"properties":{
      "profile_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"device_id":{"type":"string","format":"uuid"},
      "site_id":{"type":"string","format":"uuid"},"job_id":{"type":"string","format":"uuid"}},
      "required":["profile_sha256","device_id","site_id","job_id"]},
    "configuration_stage_request":{"type":"object","additionalProperties":false,"properties":{
      "config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"config_revision":{"type":"integer","minimum":1},
      "site_id":{"type":"string","format":"uuid"},"job_id":{"type":"string","format":"uuid"}},
      "required":["config_sha256","config_revision","site_id","job_id"]},
    "stage_response":{"type":"object","additionalProperties":false,"properties":{
      "status":{"enum":["STAGED","DEFERRED","REJECTED"]},"reason_code":{"enum":["NONE","SITE_LOCK_ACTIVE","INVALID_SIGNATURE","UNKNOWN_DEVICE","INVALID_CONFIGURATION","UNAUTHORISED_PEER","OTHER_CODED"]},
      "observed_sha256":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]}},
      "required":["status","reason_code","observed_sha256"]}
  }
}
