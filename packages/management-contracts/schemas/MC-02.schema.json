{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-02:v1.1.0",
  "title": "MC-02 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-02"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "token_proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "claim_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        },
        "installer_id": {
          "type": "string",
          "format": "uuid"
        },
        "csr_pem": {
          "type": "string",
          "minLength": 100,
          "maxLength": 8192
        },
        "host_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "agent_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid"
        },
        "csr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_algorithm": {
          "enum": [
            "Ed25519",
            "ES256"
          ]
        }
      },
      "required": [
        "claim_id",
        "token_proof",
        "claim_nonce",
        "installer_id",
        "csr_pem",
        "host_evidence_sha256",
        "agent_version",
        "installation_id",
        "csr_sha256",
        "key_algorithm"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "enum": [
            "Ed25519",
            "ES256"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "tenant_id",
    "site_id",
    "sent_at",
    "body",
    "signature"
  ]
}
