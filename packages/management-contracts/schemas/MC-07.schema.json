{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-07:v1.1.0",
  "title": "MC-07 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-07"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "component_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
        },
        "state": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "DOWN",
            "UNKNOWN"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "disk_free_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "diagnostic_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,40}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "dropped_count": {
          "type": "integer",
          "minimum": 0
        },
        "clock_confidence": {
          "enum": [
            "TRUSTED",
            "UNTRUSTED"
          ]
        }
      },
      "required": [
        "agent_id",
        "component_name",
        "state",
        "captured_at",
        "queue_depth",
        "disk_free_percent",
        "last_verified_at",
        "diagnostic_codes",
        "dropped_count",
        "clock_confidence"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "enum": [
            "Ed25519",
            "ES256"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "tenant_id",
    "site_id",
    "sent_at",
    "body",
    "signature"
  ]
}
