{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-10:v1.1.0",
  "title": "MC-10 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-10"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notice_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rollout_ring": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "incompatibilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,40}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "clinical_approval_ref": {
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "recall_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recovery_plan_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notice_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "severity": {
          "enum": [
            "INFO",
            "HIGH",
            "CRITICAL"
          ]
        }
      },
      "required": [
        "notice_id",
        "artifact_sha256",
        "rollout_ring",
        "incompatibilities",
        "clinical_approval_ref",
        "recall_reason",
        "recovery_plan_version",
        "notice_revision",
        "expires_at",
        "severity"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "sent_at",
    "body",
    "signature"
  ]
}
