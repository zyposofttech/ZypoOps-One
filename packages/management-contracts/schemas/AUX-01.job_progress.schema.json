{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:aux:job-progress:v1.2.0",
  "title": "AUX-01 O1 signed non-terminal job progress",
  "description": "Site scoped, agent signed. Informational progress only; never replaces MC-04 terminal receipt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "AUX-01"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "progress_state": {
          "enum": [
            "RECEIVED",
            "VALIDATED",
            "ACCEPTED",
            "RUNNING"
          ]
        },
        "stage_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,40}$"
        },
        "event_at": {
          "type": "string",
          "format": "date-time"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 1
        },
        "execution_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "job_id",
        "progress_state",
        "stage_code",
        "event_at",
        "sequence_number",
        "execution_id"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "enum": [
            "Ed25519",
            "ES256"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "tenant_id",
    "site_id",
    "sent_at",
    "body",
    "signature"
  ]
}
