{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-01:v1.1.0",
  "title": "MC-01 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-01"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "host_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cert_serial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,40}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "ENROLLMENT_PENDING",
            "ENROLLED",
            "CONNECTED",
            "DISCONNECTED",
            "ROTATING",
            "REVOKED"
          ]
        },
        "installation_epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "installation_id",
        "agent_id",
        "host_binding_sha256",
        "cert_serial",
        "key_version",
        "capabilities",
        "status",
        "installation_epoch"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "tenant_id",
    "site_id",
    "sent_at",
    "body",
    "signature"
  ]
}
