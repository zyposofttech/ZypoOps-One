{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-04:v1.1.0",
  "title": "MC-04 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-04"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "execution_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "stage": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,40}$"
        },
        "observed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error_code": {
          "enum": [
            "NONE",
            "APPROVAL_REQUIRED",
            "ARTIFACT_UNTRUSTED",
            "CONTRACT_INVALID",
            "CLOCK_UNTRUSTED",
            "EXECUTION_UNKNOWN",
            "IDEMPOTENCY_CONFLICT",
            "INSTALLATION_SCOPE_MISMATCH",
            "JOB_EXPIRED",
            "LOCAL_POLICY_DENIED",
            "SITE_LOCK_ACTIVE",
            "TRUST_REVOKED",
            "UNSUPPORTED_COMMAND",
            "PRECONDITION_FAILED",
            "BACKUP_NOT_VERIFIED",
            "OTHER_CODED"
          ]
        },
        "event_at": {
          "type": "string",
          "format": "date-time"
        },
        "clock_confidence": {
          "enum": [
            "TRUSTED",
            "UNTRUSTED"
          ]
        }
      },
      "required": [
        "job_id",
        "execution_id",
        "state",
        "stage",
        "observed_sha256",
        "error_code",
        "event_at",
        "clock_confidence"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "enum": [
            "Ed25519",
            "ES256"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "tenant_id",
    "site_id",
    "sent_at",
    "body",
    "signature"
  ]
}
