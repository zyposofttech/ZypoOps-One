{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-12:v1.1.0",
  "title": "MC-12 v1.1 proposed interface contract",
  "description": "Remediated candidate contract. Syntax validation does NOT prove trust; enforce detached cryptographic, policy and state checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-12"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_type": {
          "enum": [
            "FETAL_REFERENCE",
            "REPORT_TEMPLATE",
            "MEASUREMENT_MAPPING",
            "AI_MODEL",
            "CLINICAL_RULESET"
          ]
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clinical_owner_signature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alg": {
              "enum": [
                "Ed25519",
                "ES256"
              ]
            },
            "kid": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{80,128}$"
            }
          },
          "required": [
            "alg",
            "kid",
            "value"
          ]
        },
        "intended_use": {
          "type": "string",
          "maxLength": 400
        },
        "reference_version": {
          "type": "string",
          "maxLength": 80
        },
        "validation_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "package_type",
        "package_sha256",
        "clinical_owner_signature",
        "intended_use",
        "reference_version",
        "validation_evidence_sha256",
        "valid_from",
        "valid_until"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "sent_at",
    "body",
    "signature"
  ]
}
