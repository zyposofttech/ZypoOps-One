{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zyposoft:ops:contracts:mc-05:v1.1.0",
  "title": "MC-05 v1.2 globally signed deployment manifest",
  "description": "Artifact scoped; immutable across sites. Health probes and locks are generic product declarations; runtime helper must apply its own allow-list.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "MC-05"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "topology": {
          "enum": [
            "SINGLE_SITE_LAN",
            "CENTRAL_CHAIN",
            "PRIVATE_CLOUD"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
              },
              "oci_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "name",
              "oci_digest"
            ]
          },
          "maxItems": 36
        },
        "host_os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "minimum_disk_gb": {
          "type": "integer",
          "minimum": 1
        },
        "migration_policy": {
          "enum": [
            "NO_DB_CHANGE",
            "EXPAND_CONTRACT",
            "RESTORE_OR_FORWARD_FIX"
          ]
        },
        "backup_evidence_required": {
          "type": "boolean"
        },
        "required_locks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,40}$"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "health_probes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
              },
              "probe_type": {
                "enum": [
                  "HTTP",
                  "TCP",
                  "SYSTEMD"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "name",
              "probe_type",
              "target"
            ]
          },
          "minItems": 0,
          "maxItems": 24,
          "uniqueItems": true
        },
        "cpu_arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "min_memory_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 524288
        },
        "min_agent_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sbom_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "migration_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "product_id",
        "release_id",
        "topology",
        "revision",
        "components",
        "host_os",
        "minimum_disk_gb",
        "migration_policy",
        "backup_evidence_required",
        "required_locks",
        "health_probes",
        "cpu_arch",
        "min_memory_mb",
        "min_agent_version",
        "expires_at",
        "sbom_sha256"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,79}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,128}$"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "contract_id",
    "schema_version",
    "message_id",
    "sent_at",
    "body",
    "signature"
  ]
}
