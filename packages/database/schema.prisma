generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_lock {
  id             String          @id @db.Uuid
  tenant_id      String          @db.Uuid
  site_id        String          @db.Uuid
  lock_name      String          @db.VarChar(80)
  holder_job_id  String?         @db.Uuid
  acquired_at    DateTime        @db.Timestamptz(6)
  expires_at     DateTime        @db.Timestamptz(6)
  site           site            @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  management_job management_job? @relation(fields: [tenant_id, site_id, holder_job_id], references: [tenant_id, site_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, site_id, id])
  @@unique([tenant_id, site_id, lock_name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
