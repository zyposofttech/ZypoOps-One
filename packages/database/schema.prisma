model approval_grant {
  id                                 String              @id @db.Uuid
  tenant_id                          String              @db.Uuid
  site_id                            String              @db.Uuid
  target_sha256                      String              @db.Char(64)
  operation                          String              @db.VarChar(60)
  site_authoriser_key_id             String              @db.VarChar(120)
  site_authoriser_attestation_sha256 String              @db.Char(64)
  ops_grant_sha256                   String              @db.Char(64)
  maker_id                           String              @db.VarChar(160)
  checker_id                         String              @db.VarChar(160)
  valid_from                         DateTime            @db.Timestamptz(6)
  valid_until                        DateTime            @db.Timestamptz(6)
  consumed_at                        DateTime?           @db.Timestamptz(6)
  site                               site                @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  job_approval_grant                 job_approval_grant?
  support_session                    support_session[]

  @@unique([tenant_id, site_id, id])
}

